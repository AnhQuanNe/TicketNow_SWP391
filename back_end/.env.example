# =================================================================
# TicketNow Backend Environment Configuration
# =================================================================

# MongoDB Cloud Connection (Thay bằng link từ MongoDB Atlas khi deploy)
# Ví dụ: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/TicketNow?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/TicketNow

# Cổng khởi chạy server (Khi deploy lên Render/Railway nền tảng sẽ tự cấp PORT)
PORT=5000

# Khóa bí mật JWT
JWT_SECRET=supersecretkey123_change_this_in_production

# Cổng thanh toán PayOS (Lấy từ https://my.payos.vn/)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# Google OAuth 2.0 Client ID (Lấy từ Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Cấu hình gửi mail Nodemailer (Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# URL của Frontend (Khi deploy đổi thành URL Vercel/Netlify, ví dụ: https://ticketnow.vercel.app)
CLIENT_URL=http://localhost:3000

# Rate limit
DISABLE_RATE_LIMIT=true

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key
